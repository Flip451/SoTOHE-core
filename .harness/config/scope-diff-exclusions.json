{
  "schema_version": 1,
  "exclusions": [
    "target/**",
    "target-*/**",
    "**/*.rs.bk",
    ".claude/logs/**",
    ".claude/worktrees/**",
    ".fastembed_cache/**",
    "**/.fastembed_cache/**",
    ".semantic_index/**",
    "**/.semantic_index/**",
    ".semantic_index.*",
    ".cache",
    "sotp-dry-index-*/**",
    ".env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "private/**",
    "config/secrets/**",
    "tmp/**",
    ".cache/**",
    "libs/**/tmp/**",
    "apps/**/tmp/**",
    ".harness/tools/**",
    "bin/sotp",
    ".cargo-install/**",
    "repomix-output.txt",
    "repomix-output.xml",
    "repomix-output.*/**",
    ".idea/**",
    ".vscode/**",
    ".locks/**",
    "track/items/**/.commit_hash",
    "track/items/**/.commit_hash.tmp",
    "track/items/*/*-graph*/**",
    "track/items/*/logs/**"
  ]
}
