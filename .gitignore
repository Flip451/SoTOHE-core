# --- Rust ---
target/
target-*/
**/*.rs.bk

# Keep Cargo.lock for application projects.
# Uncomment the next line if this template is used for a library crate.
# Cargo.lock

# --- Tooling caches / outputs ---
.claude/logs/
.claude/worktrees/
.claude/scheduled_tasks.lock
.sotp-record-round.lock

# --- fastembed model-weight cache (downloaded at runtime; never version-controlled) ---
.fastembed_cache/
**/.fastembed_cache/

# --- DRY-check semantic index (LanceDB; local build artifact, never version-controlled) ---
# Directory plus every persistent-index sidecar at the default db-path
# (.fingerprint / .fingerprint.tmp / .lock [fs4 advisory lock] / .sotp-cache [cache marker]).
.semantic_index/
**/.semantic_index/
.semantic_index.*
sotp-dry-index-*/

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Project-specific sensitive directories (see knowledge/conventions/security.md) ---
private/
config/secrets/

# --- Editor / OS ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# --- Stale lock directory from removed file-lock system (safe to delete locally) ---
.locks/

# --- Advisory lock files created by with_locked_document (fs4) ---
*.json.lock
*.jsonl.lock

# --- Runtime lock files (review cycle mutual exclusion) ---
.sotp-record-round.lock

# --- Auto mode ephemeral session state (not version-controlled) ---
**/auto-state.json

# --- Build artifacts ---
*.rlib
rust_out

# --- Built CLI binary (regenerated by cargo make bootstrap) ---
/bin/sotp

# --- Repo-local Codex runtime link (regenerated by cargo make bootstrap) ---
/.harness/tools/

# --- Pinned sotp install root used by the template's install-sotp task ---
/.cargo-install/

# --- Generated views (rendered from metadata.json, not version-controlled) ---
track/registry.md

# --- TDDD baseline snapshots (captured by `sotp track baseline-capture`, not version-controlled) ---
track/items/**/*-baseline.json

# --- TDDD rendered type-graph cluster dirs (generated by `sotp track type-graph`, not version-controlled) ---
# Legacy suffix-less path retained for backward compatibility (no new outputs land here);
# active cluster-mode outputs use the depth-suffixed pattern below.
track/items/**/*-graph/
# Depth-suffixed cluster-mode dirs hold the current depth-specific outputs
# (e.g. `domain-graph-d1/`, `domain-graph-d2/`).
track/items/**/*-graph-d*/

# --- Review v2: per-track commit hash (local diff base state, not version-controlled) ---
track/items/**/.commit_hash
track/items/**/.commit_hash.tmp

# --- Base-merge sync stamp (local operational state written by clean-merge cleanup) ---
track/items/**/.sync-base.json
# Baseline recovery state retained when a cleanup stage fails (operational backup,
# adopted and cleaned up by a later cleanup run; never version-controlled).
track/.sotp-baseline-recovery/

# --- Provider session resume cache (runtime session state, not version-controlled) ---
track/items/**/.provider-sessions/

# --- Track workflow telemetry logs (runtime diagnostics, not version-controlled) ---
track/items/**/logs/
track/archive/**/logs/

# --- Temp / local scratch ---
tmp/
.track-template-dev
repomix-output.txt
repomix-output.xml
repomix-output.*

# --- Local Claude Code settings override (not version-controlled) ---
.claude/settings.local.json

# --- Local cached external reference guides (not version-controlled) ---
.cache/
