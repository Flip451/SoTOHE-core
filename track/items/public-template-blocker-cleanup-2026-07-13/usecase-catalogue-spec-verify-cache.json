      "verdict": {
        "kind": "pass",
        "citation": "公開元リポジトリの verify ゲートは Git 管理下の全 file を走査し、home directory 配下を指す作業機の絶対パスを最低検出対象として CI で fail-closed にする。"
      },
      "claim_origin": {
        "kind": "catalogue_entry",
        "data": {
          "file_path": "track/items/public-template-blocker-cleanup-2026-07-13/usecase-types.json",
          "section_key": "types",
          "entry_key": "VerifyInteractor"
        }
      },
      "evidence_origin": {
        "kind": "spec_element",
        "data": {
          "section": "acceptance_criteria",
          "element_id": "AC-12",
          "text_label": "公開元リポジトリの verify ゲートは Git 管理下の全 file を走査し、home directory 配下を指す作業機の絶対パスを最低検出対象として CI で fail-closed にする。対象を directory 列挙で絞り込まず、この最低対象を超える検出範囲を必須要件にしない。"
        }
      }
    },
