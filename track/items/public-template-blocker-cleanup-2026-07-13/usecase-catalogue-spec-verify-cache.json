      "evidence_hash": "9cf63c23daa8dcc022cdc0ce0dc7c3554131818ce8e049458ef824a80e33fab5",
      "verdict": {
        "kind": "pass",
        "citation": "template export smoke は export 出力を走査し、作業機の絶対パスを検出した場合に fail-closed で失敗する。"
      },
      "claim_origin": {
        "kind": "catalogue_entry",
        "data": {
          "file_path": "track/items/public-template-blocker-cleanup-2026-07-13/usecase-types.json",
          "section_key": "types",
          "entry_key": "TemplateExportError"
        }
      },
      "evidence_origin": {
        "kind": "spec_element",
        "data": {
          "section": "acceptance_criteria",
          "element_id": "AC-13",
          "text_label": "template export smoke は export 出力を走査し、作業機の絶対パスを検出した場合に fail-closed で失敗する。出力走査に用いる home directory は composition root が解決して adapter / verifier の構築時または引数として明示的に渡し、adapter / verifier は `HOME` や `USERPROFILE` などの環境変数を暗黙に読まず、home directory を解決できない場合も fail-closed にする。"
        }
      }
    },
