        {
          "type": "fast",
          "verdict": "findings_remain",
          "findings": [
            {
              "message": "The regression test invokes real `git init`/`git commit` without isolating Git configuration. A user's global/system settings such as `commit.gpgSign`, hooks, or other commit behavior can make the test fail or alter repository creation, violating the required hermetic/no-user-Git-config dependency. Run these commands with isolated config (for example `GIT_CONFIG_NOSYSTEM=1` plus an isolated `HOME`/`XDG_CONFIG_HOME`, or an explicit temporary global config).",
              "severity": "P1",
              "file": "apps/cli/tests/consumer_scaffold_host_first.rs",
              "line": 236,
              "category": "test hermeticity"
            }
          ],
          "hash": "rvw1:sha256:7d71e3eb259824869ef317daeec3bd9dc18e6dc07f3eefe30ca84ac9e0f8bc98",
          "at": "2026-07-24T23:22:33Z"
