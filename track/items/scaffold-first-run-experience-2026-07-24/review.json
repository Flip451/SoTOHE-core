        {
          "type": "final",
          "verdict": "findings_remain",
          "findings": [
            {
              "message": "The missing-identity fixture is not hermetic. `run(false)` removes only the four `GIT_AUTHOR_*`/`GIT_COMMITTER_*` variables, while Git can still derive an identity from inherited `EMAIL` and the host account/hostname. Without `user.useConfigOnly=true`, `git var` can therefore succeed on some machines, causing this regression test to exercise the successful initialization path instead. Remove all identity-related environment fallbacks and configure the isolated Git config with `user.useConfigOnly=true`.",
              "severity": "P1",
              "file": "apps/cli/tests/consumer_scaffold_host_first.rs",
              "line": 322,
              "category": "testing"
            }
          ],
          "hash": "rvw1:sha256:463b8e8b18925d3374013b98a9859e43d55a8607355a16ed75a20fc8d8264f55",
          "at": "2026-07-25T00:12:31Z"
