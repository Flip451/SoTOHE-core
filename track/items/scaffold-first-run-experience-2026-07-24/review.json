        {
          "type": "fast",
          "verdict": "findings_remain",
          "findings": [
            {
              "message": "`set -e` stops on failure but does not clean up state created by earlier steps. If `cargo generate-lockfile` fails, the exported directory is left as an initialized Git repository; if `git commit` fails, it is left with staged files. This contradicts the checklist requirement that intermediate failures not leave a half-initialized state and makes recovery/retry behavior ambiguous.",
              "severity": "P1",
              "file": "overlay/Makefile.toml",
              "line": 23,
              "category": "error-handling"
            }
          ],
