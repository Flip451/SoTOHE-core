    {
      "claim_hash": "5431793d352c3eaef4f193a50abf3752dd030d7f46985030bfccf39773224372",
      "claim_origin": {
        "data": {
          "element_id": "CN-05",
          "section": "constraint",
          "text_label": "ログ保存先の選択、衝突回避、名前の実現可能性、および子プロセス起動前に必要な予約は、永続化ポートとそのアダプターが所有しなければならない。"
        },
        "kind": "spec_element"
      },
