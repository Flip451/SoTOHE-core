    {
      "claim_hash": "36509ff69faf2a9725bd187cd5d2dcb86facd83d2d12eb37111794b5dc0cabef",
      "claim_origin": {
        "data": {
          "element_id": "IN-01",
          "section": "in_scope",
          "text_label": "Makefile.toml と bin/sotp の既存定義でテスト実行・義務評価・コミット前の集約ゲートとして扱われるタスクに、共通の stdout サマリ契約を適用する。"
        },
        "kind": "spec_element"
      },
      "evidence_hash": "1d123c1d192df6b4dc18e21bcb85b5110344d3317636d4bd4104cd3e8210b8d0",
      "evidence_origin": {
        "data": {
