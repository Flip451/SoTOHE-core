    {
      "claim_hash": "d75fc8750901c5a9d9d6e937ab0cb870ca5a1bc2055406abeb5027b5c34cb85b",
      "evidence_hash": "637f151badb5cf6bc21cdcdf1a6a4b8e53d262563d4edfe86f289b94cc601e88",
      "verdict": {
        "kind": "pass",
        "citation": "記録処理には、正の最大バイト数と正のローテーション済みファイル保持数を設定可能にする。各記録の追記前に、active ファイルの現在のバイト数とエンコード後の記録のバイト数の合計を判定する。合計が最大バイト数を超える場合は、追記前に active ファイルをローテーションし、新しい active ファイルへ記録する。保持数はローテーション済みファイルだけを数え、active ファイルは含めない。ローテーション後にその数が設定値を超えた場合は、ローテーション順で最も古いファイルから削除し、設定値以下にする。"
      },
      "claim_origin": {
        "kind": "spec_element",
        "data": {
          "section": "constraint",
          "element_id": "CN-02",
          "text_label": "ローカル JSONL の active 記録ファイルには正の最大バイト数と正の保持ファイル数を設定し、次の記録の追記で最大バイト数を超える前に active ファイルをローテーションする。ローテーション済みファイルが保持数を超える場合は最も古いものを削除する。"
        }
      },
      "evidence_origin": {
        "kind": "adr_decision",
        "data": {
          "file_path": "knowledge/adr/2026-08-01-0902-sotp-tracing-rotation-policy.md",
          "decision_id": "D1"
        }
      }
    },
