    {
      "claim_hash": "e25b2b44eeae94bdd44cb27270b3bdf5593c52c3f93a063c13959f6dba12894a",
      "claim_origin": {
        "data": {
          "element_id": "AC-03",
          "section": "acceptance_criteria",
          "text_label": "複数候補に一致し、完全修飾パスの併記もなく文脈から一意に決められない短名宣言は、候補の完全修飾パスを列挙する診断とともに失敗し、短名 identity へ fallback しない。完全修飾パスを解決できない対象も対象を示す診断とともに失敗する。"
        },
        "kind": "spec_element"
      },
      "evidence_hash": "95e7057dfe38d9b98108e8217d8c5afae74c85a54af298e40edfb6aa14e4f578",
