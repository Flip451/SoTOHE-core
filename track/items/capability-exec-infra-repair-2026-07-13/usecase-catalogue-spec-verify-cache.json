      "verdict": {
        "kind": "pass",
        "citation": "`sotp capability exec` を `--timeout-seconds` なしで実行すると provider process に一律の 600 秒上限を設定せず、完了まで待機することを検証する。正の timeout を指定した場合だけ、その値が provider process の待機上限として使われることも検証する。"
      },
      "claim_origin": {
