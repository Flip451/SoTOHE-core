          "entry_key": "CapabilityDriver"
        }
      },
      "evidence_origin": {
        "kind": "spec_element",
        "data": {
          "section": "goal",
          "element_id": "GO-01",
          "text_label": "`bin/sotp capability exec <capability-name> --host <provider> --briefing-file <path>` を、自由形式の成果物を orchestrator が消費する capability の単一かつ profile 駆動の dispatch 入口として提供する。呼び出し可能な capability、provider、model、実行経路は profile と provider-native adapter 定義から解決し、capability 名ごとの専用 runner を増設しない。"
        }
      }
    },
