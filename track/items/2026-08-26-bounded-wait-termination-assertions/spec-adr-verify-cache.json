    {
      "claim_hash": "8b8c138516af28a687e43c6a67c0979193770d46c54dd5c37d820ce8b317b7db",
      "claim_origin": {
        "data": {
          "element_id": "GO-01",
          "section": "goal",
          "text_label": "子孫プロセスの終了保証を、即時の単発状態観測ではなく、有界時間内の再観測により最終的な非存在として検証する。"
        },
        "kind": "spec_element"
      },
      "evidence_hash": "c6885256db4e12a57171ddb4eadecc3ef001eb0b76d6bb844f826408467d52c8",
      "evidence_origin": {
        "data": {
          "decision_id": "D1",
          "file_path": "knowledge/adr/2026-08-26-0211-bounded-wait-termination-assertions.md"
        },
        "kind": "adr_decision"
      },
      "verdict": {
        "citation": "プロセス・リソースの終了保証を検証するテストは、有限の時間上限内で対象の状態を再観測し、「終端状態に達した、または消滅した」ことを要求する。",
        "kind": "pass"
      }
    },
    {
