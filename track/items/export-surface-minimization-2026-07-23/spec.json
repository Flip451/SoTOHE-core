  "constraints": [
    {
      "id": "CO-01",
      "text": "新しい出荷面の整合性チェックは、テンプレート framework 自身の export / workflow / Makefile 整合性だけを対象にし、利用者の provider や agent 設定選択を CI で強制しない。",
      "adr_refs": [
        {
          "file": "knowledge/adr/2026-07-23-0117-export-surface-minimization.md",
          "anchor": "D4"
        }
