    "TaskOperationInteractor": {
      "action": "modify",
      "docs": "Existing task-operation interactor; new() gains the batch-plan reader, scope-diff measurer and scope-config reader, and transition_task delegates the judgment to evaluate_admission. Type-design: the three admission collaborators are required rather than Option so no constructible interactor can transition without judging; the pre-existing branch_reader stays Option because that guard is disabled in repository-less test environments. Port calls are scoped by the items_dir already on TaskTransitionCommand, and planned tasks come from the existing store bound rather than a new port. A refusal is returned as TaskTransitionOutcome::Rejected with its typed payload intact, not flattened into the error channel, so TaskOperationError's declared shape stays baseline-identical. IN-09, IN-10, AC-10, AC-12, AC-13, CN-10.",
      "generics": [
        {
          "bounds": [],
          "name": "S"
        }
      ],
      "informal_grounds": [],
      "kind": {
        "kind": "struct",
        "shape": {
          "fields": [],
          "has_stripped_fields": true,
          "kind": "plain"
        }
      },
