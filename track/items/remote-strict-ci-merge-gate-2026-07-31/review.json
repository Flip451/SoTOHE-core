    "cli": {
      "rounds": [
        {
          "type": "fast",
          "verdict": "findings_remain",
          "findings": [
            {
              "message": "The new `preserves_track_gates` test only inspects dependency names and never validates the `ci-track` task's `script`. Therefore it would still pass if the ADR-baseline gate (`bin/sotp adr-baseline check-commit`) were removed or replaced with a no-op, so it does not fully prove that the exported local early-detection route preserves its gates.",
              "severity": "P1",
              "file": "apps/cli/tests/consumer_scaffold_host_first.rs",
              "line": 615,
              "category": "missing regression coverage"
            }
          ],
          "hash": "rvw1:sha256:affae12a4982c183f2524c8d4c208467f7aec1444a899543b32a976b072ee9a0",
          "at": "2026-07-31T13:37:38Z"
        },
        {
          "type": "fast",
          "verdict": "zero_findings",
          "findings": [],
          "hash": "rvw1:sha256:aa36e2cb6a9bd18b4f1085fb22b3afb64616509284a54c3ee841642e11806943",
          "at": "2026-07-31T13:40:18Z"
        },
        {
          "type": "final",
          "verdict": "findings_remain",
          "findings": [
            {
              "message": "The regression does not prove that the exported `ci-track` task remains publicly invocable. Adding `private = true` or disabling the task would leave every assertion here passing, while `cargo make ci-track` would reject the route unless explicitly overridden. This permits AC-04 to regress despite a green test; assert that the task is public/enabled or verify non-executing task resolution.",
              "severity": "P1",
              "file": "apps/cli/tests/consumer_scaffold_host_first.rs",
              "line": 615,
              "category": "test_coverage"
            }
          ],
          "hash": "rvw1:sha256:aa36e2cb6a9bd18b4f1085fb22b3afb64616509284a54c3ee841642e11806943",
          "at": "2026-07-31T13:44:39Z"
        },
        {
          "type": "final",
          "verdict": "findings_remain",
          "findings": [
            {
              "message": "`task_toml_optional_value` does not parse TOML semantics: it only recognizes the exact spelling `key = ` and returns an unparsed value. Valid declarations such as `private=true` are therefore treated as absent, while `private = true # reason` compares unequal to `Some(\"true\")`. In either case both availability assertions pass even though cargo-make treats `ci-track` as private/disabled, so AC-04 can still regress. Parse these flags as TOML booleans or validate task resolution through cargo-make.",
              "severity": "P1",
              "file": "apps/cli/tests/consumer_scaffold_host_first.rs",
              "line": 103,
              "category": "test_coverage"
            }
          ],
          "hash": "rvw1:sha256:56d37f09a5ee90af7f2b0f494ed9bb6320346622f04123a3fc945c1f4a535142",
          "at": "2026-07-31T13:48:08Z"
        },
