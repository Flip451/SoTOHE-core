          "verdict": "findings_remain",
          "findings": [
            {
              "message": "`infrastructure::CodexDryChecker` restates upstream design rationale and behavior in `docs` (opaque provider strings, pass-through semantics, and prompt-label treatment) instead of referring to the governing spec anchors. Keep this field as an anchor-based summary only, per `no-upstream-restatement.md`.",
              "severity": "P1",
