          "hash": "rvw1:sha256:7efc86d64a9d16c66fff3d320df54bc7a323e1b5059d960a7b834c962d9c7251",
          "at": "2026-07-22T20:24:57Z"
        },
        {
          "type": "final",
          "verdict": "findings_remain",
          "findings": [
            {
              "message": "R1/R10 now says a ValueObject candidate is a domain concept only when another domain entry references it, but the unchanged classifier below still says concept classification depends only on domain meaning and that ambiguous cases must be modeled in domain. A domain-meaning wrapper with no inbound reference therefore receives mutually exclusive placement instructions. Align the classifier with the new inbound-reference rule.",
              "severity": "P1",
              "file": "knowledge/conventions/type-designer-kind-selection.md",
              "line": 242,
              "category": "convention contradiction"
            }
          ],
