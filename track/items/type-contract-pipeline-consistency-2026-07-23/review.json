          "at": "2026-07-22T20:24:57Z"
        },
        {
          "type": "final",
          "verdict": "findings_remain",
          "findings": [
            {
              "message": "`CatalogueLinterRule::new` accepts `DomainValueObjectInboundReferenceRequired` with a target that cannot match `ValueObject` (for example, `[Entity]`). Evaluation then filters every candidate through `target.matches(ValueObject)` and silently returns no violations, disabling a rule whose contract requires checking every domain ValueObject. This leaves an invalid configuration representable despite the fallible constructor, contrary to `prefer-type-safe-abstractions.md` §Parse-don't-validate. Reject targets that do not match `ValueObject`, ignore the generic target for this fixed-target rule, or encode the target in the rule type.",
              "severity": "P1",
              "file": "libs/domain/src/tddd/catalogue_linter.rs",
              "line": 456,
              "category": "typestate / parse-don't-validate gap"
            }
          ],
          "hash": "rvw1:sha256:c101f49243ca4b7e680db7931a114ecffafe6568d29bd4597bcf4a3638a71cd0",
          "at": "2026-07-22T20:29:09Z"
        },
        {
          "type": "final",
          "verdict": "zero_findings",
          "findings": [],
