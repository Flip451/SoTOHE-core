          "verdict": "findings_remain",
          "findings": [
            {
              "message": "R1 now makes domain `ValueObject` placement conditional on an inbound reference, but R10 still explicitly states that `ValueObject` is the domain default and requires every domain concept to be placed in a domain role. These rules conflict, so type designers cannot determine whether an unreferenced domain concept should remain a domain `ValueObject` or be moved to a usecase DTO/Command.",
              "severity": "P1",
              "file": "knowledge/conventions/type-designer-kind-selection.md",
              "line": 247,
              "category": "convention contradiction"
            }
          ],
          "hash": "rvw1:sha256:8e74c915adc268d0f09c09891d47f4e982c0e1113a57fe86530aef323562e531",
          "at": "2026-07-22T20:21:44Z"
