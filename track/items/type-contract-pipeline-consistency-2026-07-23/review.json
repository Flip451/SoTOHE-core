          "findings": [
            {
              "message": "The new inbound evaluator imports `collect_methods_for_type` from its parent module (`super`), but that function is defined in the sibling `helpers` module and is not re-exported by the parent. This causes the domain crate to fail compilation; import it via `super::helpers::collect_methods_for_type` (or re-export it).",
              "severity": "P0",
              "file": "libs/domain/src/tddd/catalogue_linter_eval_inbound.rs",
              "line": 8,
              "category": "correctness"
            }
