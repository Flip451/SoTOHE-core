      },
      "verdict": {
        "kind": "fulfilled",
        "citation": "assert_eq!(violations.len(), 1, \"action {action:?} must be checked\");\n            assert_eq!(violations[0].rule_kind(), \"DomainValueObjectInboundReferenceRequired\");\n        }\n{\n        let mut doc = make_doc(\"domain\");\n        doc.insert_type(\n            TypeName::new(\"Price\").unwrap(),\n            make_type_entry_with_methods(\n                DataRole::Entity { identity: identity_accessor(\"id\"), invariants: vec![] },\n                vec![method_shared_ref_no_params(\"amount\", \"Money\")],\n            ),\n        );\n        assert!(violations.is_empty(), \"a different domain signature consumes Money\");"
      },
      "verifier_fingerprint": "24ba81151c5d18c628a2933e263a2405d72f4989b908c10a606ebf08c29476ce"
    },
    {
      "edge_id": {
        "entry_key": "CatalogueLinterRuleKind",
        "anchor_id": {
          "file_path": "track/items/type-contract-pipeline-consistency-2026-07-23/spec.json",
          "element_id": "AC-02"
        }
      },
      "obligation_id": {
        "entry_key": "CatalogueLinterRuleKind",
        "obligation_kind": "logic",
        "item_identifier": "voluntary:AC-02"
      },
      "key": {
        "bound_tests_set_hash": "f224835ee5e52339b722d7f2b7af883d7aa4cbc0d7efe2d0114df5ddb5ca7ad2",
        "declaration_hash": "761f54c04c7b7386619f8570a6f275678191466e5e85bee403e7302a2d363bf8",
        "anchor_text_hash": "90cf8b26c8c17deb9f54ebf7d6346b92aeb685239b2095325b9d8a811d1d977c"
      },
      "verdict": {
        "kind": "fulfilled",
        "citation": "for action in [ItemAction::Add, ItemAction::Modify, ItemAction::Reference] {\n            let mut doc = make_doc(\"domain\");\n            doc.insert_type(\n                TypeName::new(\"BoundaryValue\").unwrap(),\n                TypeEntry::new(\n                    action,\n                    DataRole::value_object(),\n                    unit_struct_kind(),\n                    vec![],\n                    vec![],\n                    vec![],\n                    ModulePath::root(),\n                    None,\n                    vec![],\n                    vec![],\n                ),\n            );\n\n            let violations = run_rule(\n                &doc,\n                RuleTarget::new(vec![RoleKind::ValueObject]),\n                CatalogueLinterRuleKind::DomainValueObjectInboundReferenceRequired,\n            );\n            assert_eq!(violations.len(), 1, \"action {action:?} must be checked\");\n            assert_eq!(violations[0].rule_kind(), \"DomainValueObjectInboundReferenceRequired\");\n        }"
      },
      "verifier_fingerprint": "24ba81151c5d18c628a2933e263a2405d72f4989b908c10a606ebf08c29476ce"
