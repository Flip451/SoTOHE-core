    "TemplateConventionShippingArgs": {
      "action": "add",
      "docs": "Clap arg surface of the non-shipping check (IN-11, AC-18). Both roots are required arguments with no default, matching the export command's fully-deterministic argument style, so the check cannot silently inspect a tree the caller did not name. Both stay `PathBuf` for the reason recorded on `ConventionShippingCheckInput`. `overlay_dir` keeps the name it has on `TemplateExportArgs` because it denotes the same directory, and diverging would make the two subcommands look like they take different things.",
      "informal_grounds": [],
      "kind": {
        "kind": "struct",
        "shape": {
