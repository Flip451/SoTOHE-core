    "TemplateCommand": {
      "action": "modify",
      "docs": "Template-boundary subcommands. This track adds the read-only `CheckConventionShipping` variant (IN-11, AC-18); the existing `Export` variant and its args are untouched. The new variant carries its own args struct rather than reusing `TemplateExportArgs`, because the two argument sets have no common subset — the check names an already-produced tree plus its overlay, the export names the four inputs it consumes — and a shared struct would have to make both halves optional, admitting argument combinations neither subcommand accepts.",
      "informal_grounds": [],
      "kind": {
        "kind": "enum",
        "variants": [
          {
            "name": "Export",
            "payload": {
