  "schema_version": 2,
  "scope": {
    "in_scope": [
      {
        "adr_refs": [
          {
            "anchor": "D1",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          },
          {
            "anchor": "D2",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "IN-01",
        "text": "両検証器へ渡す各仕様要素の意味入力で、既存の構造化仕様モデルを正として識別子・所属区分・本文を保持する。所属区分を識別子接頭辞や本文から推測せず、対象外の内容を肯定的な実装要求として表示しない。"
      },
      {
        "adr_refs": [
          {
            "anchor": "D2",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "IN-02",
        "text": "対象外を、実装義務を生まない範囲境界、非保証、対象責務に属する明示禁止として区別して解釈する。対象外の参照関係を一括除外・自動免除せず、材料不足は既存の保留経路で扱う。"
      },
      {
        "adr_refs": [
          {
            "anchor": "D3",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "IN-03",
        "text": "履行・免除の判定を、義務の対象である宣言項目が所有する参照先仕様の振る舞いに限定する。責務越境の報告は、実際の判定入力に届く宣言・義務の同一性と説明・テスト本文または免除理由を照合して診断し、確認された入力欠落だけを補う。"
      },
      {
        "adr_refs": [
          {
            "anchor": "D4",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "IN-04",
        "text": "評価、確認、結果表示が同じ正規化済み判定要求全体から意味入力の鮮度を決めるようにする。仕様区分・対象責務を含む可変の意味入力、要求構造、または判定意味論に関わる入力形式の改訂は、旧合否を再利用不能にする。"
      },
      {
        "adr_refs": [
          {
            "anchor": "D5",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "IN-05",
        "text": "入力構築・検証器指示・鮮度判定について決定的な回帰検証を追加し、通常のビルド・更新経路で、既存キャッシュを残したまま修正後の評価と確認を行う。"
      }
    ],
    "out_of_scope": [
      {
        "adr_refs": [
          {
            "anchor": "D2",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          },
          {
            "anchor": "D3",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "OUT-01",
        "text": "参照関係を評価対象から除外・自動免除して対象外の問題を回避すること、または対象の責務を増やして既存の判定に合わせること。"
      },
      {
        "adr_refs": [
          {
            "anchor": "D3",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          },
          {
            "anchor": "D4",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "OUT-02",
        "text": "入力不足の確認前に外部文脈取得を追加すること、またはリポジトリ・上流成果物を都度探索して責務や鮮度の意味入力を推定すること。"
      },
      {
        "adr_refs": [
          {
            "anchor": "D4",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          },
          {
            "anchor": "D5",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "OUT-03",
        "text": "キャッシュの削除・手編集、ゲート緩和、または同一条件で合格するまでの反復を、判定更新または修正確認の経路にすること。"
      },
      {
        "adr_refs": [
          {
            "anchor": "D4",
            "file": "knowledge/adr/2026-09-11-1320-test-obligation-verifier-context-integrity.md"
          }
        ],
        "id": "OUT-04",
        "text": "モデル、提供者、実行段階を検証器指紋の構成要素へ追加すること。"
      }
    ]
  },
